{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/pre_tool_use_commit_policy.py\"",
            "timeout": 10,
            "statusMessage": "Checking git commit message policy"
          }
        ]
      }
    ]
  }
}
